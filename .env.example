# ──────────────────────────────────────────────
# Paddy Environment Variables
# Copy to .env and fill in values. Never commit real secrets.
# ──────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://paddy:paddy@localhost:5432/paddy?schema=public"

# Redis (provisioned; not yet used by code — rate limiting is in-memory per web instance)
REDIS_URL="redis://localhost:6379"

# Auth (currently unused: sessions are opaque DB tokens; keep set for future signing)
AUTH_SECRET="generate-a-long-random-string-here"

# Application
APP_URL="http://localhost:3000"
NODE_ENV="development"

# AI Provider (OpenAI-compatible)
AI_PROVIDER="openai"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"

# Web Push (generate: npx web-push generate-vapid-keys)
VAPID_SUBJECT="mailto:you@example.com"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Production Docker Compose
# POSTGRES_USER=paddy
# POSTGRES_PASSWORD=
# POSTGRES_DB=paddy
# DOMAIN=your-domain.com
# WORKER_POLL_MS=15000

# Email delivery for "Your little secret from Paddy 💚"
# Provider order: RESEND_API_KEY → SMTP_HOST → console log (dev only).
# In production at least one provider is REQUIRED or sign-up will fail loudly.
EMAIL_FROM="Paddy <noreply@your-domain.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""          # "true" for implicit TLS (port 465); default auto
SMTP_USER=""
SMTP_PASSWORD=""

# Secret Phrase challenge lifetime (minutes, default 15)
# AUTH_CHALLENGE_TTL_MINUTES=15
