// Paddy - AI Companion Platform
// Prisma schema for Phase 1 (full schema prepared for Phase 2)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ──────────────────────────────────────────────
// Users & Auth
// ──────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  emailVerifiedAt       DateTime? @map("email_verified_at")
  passwordHash          String?   @map("password_hash")
  accountStatus         String    @default("active") @map("account_status") // active | suspended | deleted
  timezone              String    @default("UTC")
  preferredLanguage     String    @default("en") @map("preferred_language")
  ageEligibilityStatus  String?   @map("age_eligibility_status") // verified_adult | underage | unknown
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  profile               UserProfile?
  companionPreferences  CompanionPreferences?
  notificationPreferences NotificationPreferences?
  conversations         Conversation[]
  messages              Message[]
  memories              Memory[]
  lifeEvents            LifeEvent[]
  goals                 Goal[]
  followUps             FollowUp[]
  pushSubscriptions     PushSubscription[]
  notificationDeliveries NotificationDelivery[]
  memoryProcessingJobs  MemoryProcessingJob[]
  emailAuthChallenges   EmailAuthChallenge[]
  auditEvents           AuditEvent[]
  sessions              Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum ChallengePurpose {
  verify_email
  reset_password
  change_email
  sensitive_action

  @@map("challenge_purpose")
}

// Paddy Secret Phrase challenges (see BLUEPRINT_SECRET_PHRASE.txt).
// - token_hash:  sha256 of the high-entropy link token (Method A, click-to-verify)
// - handle_hash: sha256 of an opaque handle kept in an httpOnly cookie in the
//                requesting browser. The pasted phrase (Method B) is only
//                accepted together with this handle, never with email alone.
// - phrase:      UX only. Never a credential on its own.
model EmailAuthChallenge {
  id               String           @id @default(cuid())
  userId           String?          @map("user_id")
  email            String
  purpose          ChallengePurpose
  tokenHash        String           @unique @map("token_hash")
  handleHash       String           @unique @map("handle_hash")
  phrase           String
  expiresAt        DateTime         @map("expires_at")
  consumedAt       DateTime?        @map("consumed_at")
  attemptCount     Int              @default(0) @map("attempt_count")
  createdAt        DateTime         @default(now()) @map("created_at")
  requestMetadata  Json?            @map("request_metadata") // { ip, userAgent } only

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, consumedAt])
  @@index([expiresAt])
  @@map("email_auth_challenges")
}

// ──────────────────────────────────────────────
// Profile & Preferences
// ──────────────────────────────────────────────

model UserProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique @map("user_id")
  displayName          String   @map("display_name")
  preferredName        String?  @map("preferred_name")
  personalIntroduction String?  @map("personal_introduction")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model CompanionPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique @map("user_id")
  relationshipStyle       String   @default("friend") @map("relationship_style") // friend | best_friend | romantic | develop_naturally
  humourLevel             Int      @default(50) @map("humour_level") // 0-100
  directnessLevel         Int      @default(50) @map("directness_level")
  responseLength          String   @default("balanced") @map("response_length") // concise | balanced | detailed
  affectionLevel          Int      @default(30) @map("affection_level")
  flirtingEnabled         Boolean  @default(false) @map("flirting_enabled")
  communicationPreferences Json?   @map("communication_preferences")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_preferences")
}

model NotificationPreferences {
  id                         String   @id @default(cuid())
  userId                     String   @unique @map("user_id")
  proactiveEnabled           Boolean  @default(false) @map("proactive_enabled")
  contextualFollowupsEnabled Boolean  @default(true) @map("contextual_followups_enabled")
  spontaneousMessagesEnabled Boolean  @default(false) @map("spontaneous_messages_enabled")
  quietHoursStart            String?  @map("quiet_hours_start") // HH:mm
  quietHoursEnd              String?  @map("quiet_hours_end")
  timezone                   String   @default("UTC")
  dailySpontaneousLimit      Int      @default(1) @map("daily_spontaneous_limit")
  notificationPreviewMode    String   @default("generic") @map("notification_preview_mode") // generic | detailed
  updatedAt                  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ──────────────────────────────────────────────
// Conversations & Messages
// ──────────────────────────────────────────────

model Conversation {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  title         String?
  status        String    @default("active") // active | archived | deleted
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastMessageAt DateTime? @map("last_message_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  memories Memory[]
  followUps FollowUp[]
  memoryProcessingJobs MemoryProcessingJob[]

  @@index([userId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id               String   @id @default(cuid())
  conversationId   String   @map("conversation_id")
  userId           String   @map("user_id")
  role             String   // user | assistant | system
  content          String
  origin           String   @default("user") // user | assistant | proactive
  generationStatus String?  @map("generation_status") // pending | streaming | completed | failed
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories     Memory[]

  @@index([conversationId, createdAt])
  @@index([userId])
  @@map("messages")
}

// ──────────────────────────────────────────────
// Memory (Phase 2 primary, schema ready)
// ──────────────────────────────────────────────

model Memory {
  id                  String    @id @default(cuid())
  userId              String    @map("user_id")
  category            String    // personal_fact | preference | episodic | relationship | goal | ongoing_situation
  content             String
  confidence          Float     @default(0.8)
  importance          Float     @default(0.5)
  sensitivity         String    @default("normal") // normal | sensitive | highly_sensitive
  sourceConversationId String?  @map("source_conversation_id")
  sourceMessageId     String?   @map("source_message_id")
  embedding           Unsupported("vector(1536)")?
  validFrom           DateTime? @map("valid_from")
  validUntil          DateTime? @map("valid_until")
  lastConfirmedAt     DateTime? @map("last_confirmed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceConversation Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([userId, category])
  @@index([userId, deletedAt])
  @@map("memories")
}

// ──────────────────────────────────────────────
// Life Context
// ──────────────────────────────────────────────

model LifeEvent {
  id                   String    @id @default(cuid())
  userId               String    @map("user_id")
  title                String
  description          String?
  eventAt              DateTime? @map("event_at")
  timezone             String?
  status               String    @default("upcoming") // upcoming | ongoing | completed | cancelled
  sourceConversationId String?   @map("source_conversation_id")
  userConfirmed        Boolean   @default(false) @map("user_confirmed")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  followUps FollowUp[]

  @@index([userId, status])
  @@index([userId, eventAt])
  @@map("life_events")
}

model Goal {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  title         String
  description   String?
  targetAt      DateTime? @map("target_at")
  status        String    @default("active") // active | completed | abandoned
  progressNotes String?   @map("progress_notes")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

// ──────────────────────────────────────────────
// Follow-ups & Notifications
// ──────────────────────────────────────────────

model FollowUp {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  eventId          String?   @map("event_id")
  sourceMemoryId   String?   @map("source_memory_id")
  conversationId   String?   @map("conversation_id")
  type             String    // explicit | contextual | spontaneous
  status           String    @default("proposed") // proposed | scheduled | processing | delivered | cancelled | dismissed | failed | expired
  scheduledAt      DateTime? @map("scheduled_at")
  timezone         String?
  messageIntent    String?   @map("message_intent")
  idempotencyKey   String    @unique @map("idempotency_key")
  attemptCount     Int       @default(0) @map("attempt_count")
  lastAttemptAt    DateTime? @map("last_attempt_at")
  deliveredAt      DateTime? @map("delivered_at")
  cancelledAt      DateTime? @map("cancelled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event              LifeEvent?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  conversation       Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  notificationDeliveries NotificationDelivery[]

  @@index([userId, status])
  @@index([status, scheduledAt])
  @@map("follow_ups")
}

model PushSubscription {
  id                      String    @id @default(cuid())
  userId                  String    @map("user_id")
  endpoint                String
  encryptedSubscriptionKeys String  @map("encrypted_subscription_keys") // JSON encrypted
  createdAt               DateTime  @default(now()) @map("created_at")
  lastSuccessfulDeliveryAt DateTime? @map("last_successful_delivery_at")
  disabledAt              DateTime? @map("disabled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NotificationDelivery {
  id                   String    @id @default(cuid())
  followUpId           String    @map("follow_up_id")
  userId               String    @map("user_id")
  channel              String    @default("web_push") // web_push | email
  status               String    // pending | sent | failed | expired
  attemptCount         Int       @default(0) @map("attempt_count")
  providerResponseCode String?   @map("provider_response_code")
  attemptedAt          DateTime? @map("attempted_at")
  completedAt          DateTime? @map("completed_at")

  followUp FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([followUpId])
  @@map("notification_deliveries")
}

model MemoryProcessingJob {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  conversationId String    @map("conversation_id")
  status         String    @default("pending") // pending | processing | completed | failed
  attemptCount   Int       @default(0) @map("attempt_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  lastErrorCode  String?   @map("last_error_code")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("memory_processing_jobs")
}

// ──────────────────────────────────────────────
// Audit
// ──────────────────────────────────────────────

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_events")
}
