# Paddy background worker + migration runner.
# Ships the Prisma CLI and tsx (both are runtime dependencies in package.json).
FROM node:22-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --omit=dev && npx prisma generate && npm cache clean --force

COPY tsconfig.json ./
COPY src ./src

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker
USER worker

# Default: the worker loop. The compose `migrate` service overrides this with
# `node_modules/.bin/prisma migrate deploy`.
CMD ["node_modules/.bin/tsx", "src/worker/index.ts"]
