# Paddy background worker
FROM node:22-alpine AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 worker

COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY prisma ./prisma
COPY src ./src
COPY tsconfig.json ./
COPY scripts/docker-entrypoint-worker.sh /app/docker-entrypoint-worker.sh

RUN npx prisma generate && chmod +x /app/docker-entrypoint-worker.sh

USER worker

ENTRYPOINT ["/app/docker-entrypoint-worker.sh"]
CMD ["npx", "tsx", "src/worker/index.ts"]
